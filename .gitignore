# Unity generated
Library/
Temp/
Logs/
Obj/
Build/
Builds/
UserSettings/
MemoryCaptures/

# Visual Studio / Rider
.vs/
.idea/
# Root-anchored: Unity auto-generates IDE project files at the repo root (Assembly-CSharp.csproj,
# Mirror.csproj, etc.) — a blanket `*.csproj` also swallowed the real, hand-authored
# api/Ueq.ContentApi.csproj, so it was silently never committed. Anchoring to root only fixes that
# without letting the ~90 Unity-generated root files back in.
/*.csproj
/*.sln
/*.slnx
*.suo
*.user
*.userprefs

# OS
.DS_Store
Thumbs.db

# Database / secrets (local only — see .env.example / db.config.example.json)
.env
db.config.json

# Content web stack (M2.1 — Angular SPA + .NET API monorepo)
/api/bin/
/api/obj/
# api/appsettings.Development.json holds the local DB password (parity with db.config.json)
/api/appsettings.Development.json
/web/node_modules/
/web/dist/

# 6.4 — launcher (.NET WinForms, its own build output)
/launcher/Ueq.Launcher/bin/
/launcher/Ueq.Launcher/obj/
/web/.angular/

# NuGetForUnity restored packages (restored from Assets/packages.config)
/Assets/Packages/
/Assets/Packages.meta

# Unity crash-recovery scratch (kept locally, not versioned)
/Assets/_Recovery/
/Assets/_Recovery.meta

# Stray debug screenshots dumped into the scripts folder (kept locally, not versioned)
/Assets/Scripts/*.jpg
/Assets/Scripts/*.jpg.meta

# Synty packs under evaluation (gitignore-while-exploring). Un-ignore a pack once it's adopted for a
# vertical so its used assets get committed. Remove the line to adopt.
/Assets/Synty/PolygonFantasyRivals/
/Assets/Synty/PolygonFantasyRivals.meta
/Assets/Synty/PolygonFantasyCharacters/
/Assets/Synty/PolygonFantasyCharacters.meta
